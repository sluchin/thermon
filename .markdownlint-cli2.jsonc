{
  "config": {
    // 全ての規則を有効にする. 次の 1 つだけ無効にする.
    "default": true,
    // MD013 (line-length): 1 行を 80 桁までにする.
    // 日本語の文は段落を 1 行で書く (途中で折り返すと, 表示に空白が入る) ので, 使わない.
    "MD013": false,
    // MD033 (no-inline-html): HTML を禁止する. 画面の画像に使う, 大きさを指定する <a> と <img> だけ許す.
    "MD033": {"allowed_elements": ["a", "img"]},
    // MD060 (table-column-style): 表の | の前後の空白をそろえる. 詰めた形 (| a | b |) に決める.
    "MD060": {
      "style": "compact"
    }
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    ".git/**",
    ".claude/**",
    ".github/**",
    ".gemini.md",
    "build/**",
    "dist/**",
    "coverage/**",
    "app/build/**",
    "core/build/**"
  ]
}
