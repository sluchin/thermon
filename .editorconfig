# EditorConfig: https://editorconfig.org/
# ktlint (整形) も, この設定を読む

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{xml,yml,yaml,toml}]
indent_style = space
indent_size = 2

[gradlew.bat]
end_of_line = crlf
